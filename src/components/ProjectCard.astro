---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<div class={`project-card fade-in${project.featured ? ' featured' : ''}`}>
  {project.github && (
    <a
      class="card-stretched-link"
      href={project.github}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`查看 ${project.title} 源码`}
    ></a>
  )}
  <div>
    <div class="project-meta">
      <span class="project-type">{project.type}</span>
      {project.github && (
        <div class="project-links">
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="project-link"
            title="GitHub"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          </a>
        </div>
      )}
    </div>

    <div class="project-title">{project.title}</div>
    <div class="project-period">{project.period}</div>

    <p class="project-desc">{project.description}</p>

    {project.highlights.length > 0 && (
      <div class="project-highlights">
        {project.highlights.map((h) => (
          <div class="highlight-item">{h}</div>
        ))}
      </div>
    )}

    <div class="project-stack" style="margin-top:1.25rem;">
      {project.stack.map((s) => (
        <span class="stack-tag">{s}</span>
      ))}
    </div>

    {!project.featured && project.github && (
      <a
        href={project.github}
        target="_blank"
        rel="noopener noreferrer"
        class="project-source-link"
      >
        查看源码 →
      </a>
    )}
  </div>

  {project.featured && project.stats && project.stats.length > 0 && (
    <div class="project-stats">
      {project.stats.map((stat) => (
        <div class={`project-stat ${stat.variant}`}>
          <div class="project-stat-value">{stat.value}</div>
          <div class="project-stat-label">{stat.label}</div>
        </div>
      ))}
    </div>
  )}
</div>

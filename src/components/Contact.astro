---
import { site } from '../config/site';

const githubDisplay = site.github.replace(/^https?:\/\//, '');
---

<section id="contact" class="contact-section" style="max-width:100%; padding: 6rem 0;">
  <div style="max-width:1100px; margin:0 auto; padding: 0 4rem;">
    <div class="contact-grid">
      <div class="fade-in">
        <div class="section-tag">06 &nbsp; contact</div>
        <div class="contact-heading">
          Let's <span class="accent">Connect</span>
        </div>
        <p class="contact-desc">
          目前正在寻找 Java / Android 全职机会，期望城市{site.seekingCities.join('、')}。
          如果你觉得我们可以合作，欢迎随时联系！
        </p>
        <div class="hero-btns">
          <a href={`mailto:${site.email}`} class="btn btn-primary">发邮件联系</a>
        </div>
      </div>

      <div class="contact-links fade-in">
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="contact-link">
          <div class="contact-link-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          </div>
          <div>
            <div class="contact-link-label">GitHub</div>
            <div class="contact-link-value">{githubDisplay}</div>
          </div>
        </a>

        {site.phonePublic && (
          <a href={`tel:${site.phone}`} class="contact-link">
            <div class="contact-link-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.6 3.44 2 2 0 0 1 3.57 1.25h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.75a16 16 0 0 0 6.29 6.29l.91-.91a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <div class="contact-link-label">手机</div>
              <div class="contact-link-value">{site.phoneDisplay}</div>
            </div>
          </a>
        )}

        <a href={`mailto:${site.email}`} class="contact-link">
          <div class="contact-link-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <div>
            <div class="contact-link-label">邮箱</div>
            <div class="contact-link-value">{site.email}</div>
          </div>
        </a>

        <div class="contact-link" style="cursor:default;">
          <div class="contact-link-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <div>
            <div class="contact-link-label">期望城市</div>
            <div class="contact-link-value">{site.seekingCities.join(' · ')}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
